{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*", "src/.env.d.ts","styled-system"],
  "exclude": ["dist"],
  "compilerOptions": {
    "strictNullChecks": true,
    "rootDir": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@styled-system/*": ["./styled-system/*"]
    }
  }
}
